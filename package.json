{
  "name": "sgu-gargamel-goi-ten",
  "version": "1.0.0",
  "private": true,
  "description": "Gargamel bắt Xì Trum SGU — mini-game random gọi tên sinh viên Trường Đại học Sài Gòn",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fastify/static": "^10.1.6",
    "@neondatabase/serverless": "^1.2.0",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@vercel/node": "^24.0.3",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "phaser": "^3.90.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts --port=3000",
    "dev:client": "vite --port 5173 --strictPort",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "tsx scripts/seed.ts",
    "import:art": "node scripts/import-art.mjs",
    "build:vercel": "vite build && node scripts/build-vercel.mjs",
    "migrate:sqlite": "tsx scripts/migrate-sqlite.ts"
  }
}
